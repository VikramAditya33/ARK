# Copy this file to .env and replace placeholders with local values.
# Never commit .env.

NODE_ENV=development
DATABASE_URL=postgresql://ark:replace-me@127.0.0.1:54329/ark
REDIS_URL=redis://127.0.0.1:63799

OBJECT_STORE_ENDPOINT=http://127.0.0.1:9009
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_BUCKET=ark-local
OBJECT_STORE_ACCESS_KEY_ID=replace-me
OBJECT_STORE_SECRET_ACCESS_KEY=replace-me

SOLARI_API_KEY=slr_live_replace_me
SOLARI_BASE_URL=https://api.getsolari.com
SOLARI_MAX_CONCURRENCY=3
SOLARI_MAX_SESSION_MINUTES=10
SOLARI_MAX_RUN_CREDITS=2

ENCRYPTION_MASTER_KEY_REF=local-development-key
TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional AI providers. ARK must operate without either during CI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

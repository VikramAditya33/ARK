{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "ANTHROPIC_API_KEY",
    "DATABASE_URL",
    "ENCRYPTION_MASTER_KEY_REF",
    "NODE_ENV",
    "OBJECT_STORE_ACCESS_KEY_ID",
    "OBJECT_STORE_BUCKET",
    "OBJECT_STORE_ENDPOINT",
    "OBJECT_STORE_REGION",
    "OBJECT_STORE_SECRET_ACCESS_KEY",
    "OPENAI_API_KEY",
    "REDIS_URL",
    "SOLARI_API_KEY",
    "SOLARI_BASE_URL",
    "SOLARI_MAX_CONCURRENCY",
    "SOLARI_MAX_RUN_CREDITS",
    "SOLARI_MAX_SESSION_MINUTES",
    "TRUSTED_ORIGINS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["reports/e2e/**"]
    },
    "test:live-solari": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["reports/live-solari/**"]
    }
  }
}

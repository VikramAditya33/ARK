{
  "name": "ark",
  "version": "0.0.0",
  "private": true,
  "description": "Operational continuity for SaaS-dependent companies, powered by Solari.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint apps packages tools --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "vitest run tests/e2e",
    "test:live-solari": "pnpm --filter @ark/testkit test:live-solari",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "db:migrate:local": "tsx --env-file=infra/compose/.env packages/db/src/migrate.ts",
    "secrets:check": "node tools/check-secrets.mjs",
    "audit": "pnpm audit --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
